{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --config jest.config.ts tests/unit --forceExit",
    "test:integration": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --config jest.config.ts --runInBand tests/integration --forceExit",
    "test:coverage": "npm run test:unit -- --coverage && npm run test:integration -- --coverage",
    "test:ci": "npm run test:unit -- --ci && npm run test:integration -- --ci",
    "test:watch": "node --max-old-space-size=4096 node_modules/jest/bin/jest.js --config jest.config.ts --watch",
    "test:load": "tsx scripts/load-test.ts",
    "test:load:auth": "tsx scripts/scenarios/auth.scenario.ts",
    "test:load:organizations": "tsx scripts/scenarios/organization.scenario.ts",
    "test:load:customers": "tsx scripts/scenarios/customer.scenario.ts",
    "test:load:categories": "tsx scripts/scenarios/category.scenario.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "check:config": "tsx scripts/check_config.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1062.0",
    "@aws-sdk/s3-request-presigner": "^3.1062.0",
    "@bull-board/api": "^7.1.5",
    "@bull-board/express": "^7.1.5",
    "@opentelemetry/auto-instrumentations-node": "^0.76.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-node": "^0.218.0",
    "@opentelemetry/semantic-conventions": "^1.41.1",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-stringify": "^6.7.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-basic-auth": "^1.2.1",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.2.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^7.0.6",
    "pdfkit": "^0.18.0",
    "pino": "^9.9.5",
    "pino-http": "^10.5.0",
    "pino-pretty": "^13.1.3",
