model Document {
  id             String       @id @default(uuid())
  organizationId String
  documentType   String
  entityType     String
  entityId       String
  fileName       String
  mimeType       String
  s3Key          String
  fileSize       Int
  uploadedById   String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
}
